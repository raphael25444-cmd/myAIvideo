# Frontend -> AI backend connection
PYTHON_BACKEND_URL=http://localhost:8000

# Postgres (used by the Next.js app health check / future features)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---- AI engine options (consumed by ai/main.py via docker-compose) ----
# VISIONAI_ENGINE=procedural        # or "diffusers" for a real diffusion model
# VISIONAI_DEVICE=auto              # auto | cpu | cuda | mps
# STORAGE_DIR=/app/storage
# KEEP_FILES_HOURS=24
# RATE_LIMIT_PER_MINUTE=30
# DIFFUSERS_MODEL=runwayml/stable-diffusion-v1-5
